# ─── Конверсия железа в токены / Hardware → Tokens ───

fn железо_в_токены(устройство) {
    # Каждый TFLOPS = 1000 токенов утки
    # GPU: tflops * 1000
    # CPU: ядра * 50
    # RAM: гб * 100
    # NPU: если есть, +2000 бонус

    пусть токены = 0

    если устройство["тип"] == "gpu" {
        токены = устройство["tflops"] * 1000
        кряк("GPU:", устройство["модель"], "→", токены, "токенов")
    }

    если устройство["тип"] == "cpu" {
        токены = устройство["ядра"] * 50
        кряк("CPU:", устройство["ядра"], "ядер →", токены, "токенов")
    }

    если устройство["тип"] == "ram" {
        токены = устройство["гб"] * 100
        кряк("RAM:", устройство["гб"], "ГБ →", токены, "токенов")
    }

    вернуть токены
}

